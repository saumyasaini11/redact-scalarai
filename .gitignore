# Python
__pycache__/
*.py[cod]
.coverage

# Test caches (disabled via pytest.ini -p no:cacheprovider)
.pytest_cache/
.tmp/

# Private runtime data — never commit
data/private/*
!data/private/.gitkeep
data/output/*
!data/output/.gitkeep
data/app_runs/
data/input/*
!data/input/.gitkeep

# Reports with raw values
reports/rendered/
reports/*.private.*
reports/pii_detection_log.sanitized.jsonl

# Distribution archives
dist/
output/pdf/

# Environment
.env
.venv/
